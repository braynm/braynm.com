# Hugo fingerprints js/ and css/, so a changed file gets a new name.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
# A font never changes in place: a new font gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Typua's build hashes every file in assets/, including the 3.7 MB TypeScript worker.
/typua/assets/*
  Cache-Control: public, max-age=31536000, immutable
